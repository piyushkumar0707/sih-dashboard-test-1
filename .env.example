# Travira Backend Environment Configuration

# MongoDB Configuration
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority

# Generate one secret and use the same value for the Node backend and both FastAPI services.
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long

# Server Configuration
PORT=5000
NODE_ENV=development

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000
VITE_API_BASE_URL=http://localhost:5000

# AI Services URLs
AI_SAFETY_SCORE_URL=http://localhost:8001
AI_CASE_REPORT_URL=http://localhost:8002

# Blockchain Service URL
BLOCKCHAIN_API_URL=http://localhost:4000

# Blockchain Configuration (from Blockchain/.env)
ALCHEMY_AMOY_URL=your_alchemy_url_here
PRIVATE_KEY=your_private_key_here
NETWORK=amoy
