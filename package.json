{
  "scripts": {
    "dev": "npm --prefix frontend run start",
    "backend": "node -r dotenv/config backend/index.js",
    "ai:safety": "python -m uvicorn main:app --app-dir AI_services/safety_score --host 0.0.0.0 --port 8001",
    "ai:case": "python -m uvicorn main:app --app-dir AI_services/case_report --host 0.0.0.0 --port 8002",
